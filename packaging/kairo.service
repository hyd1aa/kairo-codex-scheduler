[Unit]
Description=Kairo Codex quota window scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3
[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
ExecStartPre=+@PREFIX@/manager/kairo --data-dir /var/lib/kairo update recover --prefix @PREFIX@
ExecStart=@PREFIX@/current/bin/kairo --data-dir /var/lib/kairo daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StateDirectory=kairo kairo-account-guards
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@PREFIX@ -@HOME@/.codex
[Install]
WantedBy=multi-user.target
